{
	"name": "eduevent",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"prepare": "cd .. && npx husky frontend/.husky"
	},
	"dependencies": {
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "3.9.10",
		"typescript": "^5"
	},
	"packageManager": "bun@1.3.11",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,md,yaml,yml}": [
			"prettier --write"
		],
		"../backend/**/*.py": [
			"../.venv/bin/black"
		]
	}
}
